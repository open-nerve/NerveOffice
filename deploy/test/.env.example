# 测试环境的变量（deploy/test/compose.yaml）。复制为同目录的 .env（不入库）后修改。
# 密码只用字母与数字：它们要拼进数据库的连接串。pnpm test:e2e:container 每次运行时自己生成随机密码与主密钥，不读这个文件。

# 用 deploy/Dockerfile 构建的镜像
NERVE_IMAGE=nerve-office:test

# 数据库管理员、所有者角色（执行迁移）、应用角色（应用运行时）的密码。只在第一次初始化数据卷时生效
NERVE_DB_ADMIN_PASSWORD=replaceWithRandomAdminPassword
NERVE_DB_OWNER_PASSWORD=replaceWithRandomOwnerPassword
NERVE_DB_APP_PASSWORD=replaceWithRandomAppPassword

# 本机密钥的主密钥（M3-P6）：只给应用容器。用 openssl rand -base64 32 生成，把输出（44 个字符、以 = 结尾）整个填在这里；
# 下面的占位不是合法的取值，不换掉的话应用拒绝启动。它不在数据库里，也不在数据库的备份里：要单独保管，恢复备份时用同一把，
# 不要随手更换（换了等于丢失）。保管、备份、丢失与泄露的处置见部署说明的"本机密钥的主密钥"
NERVE_LOCAL_KEYS_MASTER_KEY=replaceWithTheOutputOfOpensslRandBase64

# 发布到本机回环的端口：HTTPS（公开地址是 https://localhost:<端口>）与数据库
NERVE_TEST_HTTPS_PORT=8443
NERVE_TEST_DB_PORT=54319

NERVE_LOG_LEVEL=info
# 按客户端地址的登录失败上限（窗口 15 分钟）：E2E 运行时调高
NERVE_LOGIN_IP_MAX_FAILURES=50
# 登录失败的另外两个上限（窗口 15 分钟，M2-P6）。不设时就是这些默认值：按"用户名 + 客户端地址"5 次锁定这个组合；
# 只按用户名 50 次锁定这个账户（系统管理员可以在账户页解除），必须大于上一项
#NERVE_LOGIN_MAX_FAILURES=5
#NERVE_LOGIN_ACCOUNT_MAX_FAILURES=50
# 同一条一次性链接"找到了但不能用"（过期、已用、已作废）的次数上限：到了之后这条链接暂时一律拒绝，不再写审计
#NERVE_LINK_RECORD_MAX_FAILURES=10

# 回收站里到期（30 天）的东西由应用自己清理（M2-P4）。下面三项不设时就是这些默认值；
# 排查数据时可以把 NERVE_TRASH_PURGE_ENABLED 设成 false 暂时关掉（关掉之后到期的东西要人工永久删除）
#NERVE_TRASH_PURGE_ENABLED=true
#NERVE_TRASH_PURGE_INTERVAL_MS=3600000
#NERVE_TRASH_PURGE_BATCH=50

# 修订记录与回执的保留期（M3-P3）：默认 30 天，至少 15 天（要长于本机发件箱的 14 天，否则发件箱里结果未知的保存重发时重放不了）。
# 过了保留期的由应用自己删（每份文档当前修订的那一行一直保留）；下面四项不设时就是这些默认值，排查数据时可以把清理暂时关掉
#NERVE_REVISION_RETENTION_DAYS=30
#NERVE_REVISION_PURGE_ENABLED=true
#NERVE_REVISION_PURGE_INTERVAL_MS=3600000
#NERVE_REVISION_PURGE_BATCH=1000

# 最低客户端构建（M3-P3，x.y.z）：页面有严重缺陷、修复已经发布时设成修复的版本，还开着的旧页面在保存、申请编辑权与心跳时
# 被拦下、提示刷新。不设时不按构建拦（数据格式变了的旧页面照样被拦）；改了要重启应用
#NERVE_MIN_CLIENT_BUILD=0.1.0

# 本机草稿默认开启；敏感部署设 false，重启生效。只认 true/false，不会自动删除已有草稿
#NERVE_LOCAL_DRAFTS_ENABLED=true

# 快照检查的子进程池（M3-P3）：下面几项不设时就是这些默认值。容器的内存上限要不低于
# 子进程数 ×（堆上限 + 约 100 MiB）+ 约 500 MiB（见部署说明的"快照检查的子进程与内存"）
#NERVE_SNAPSHOT_INSPECTION_PROCESSES=2
#NERVE_SNAPSHOT_INSPECTION_QUEUE_MAX=8
#NERVE_SNAPSHOT_INSPECTION_QUEUE_TIMEOUT_MS=10000
#NERVE_SNAPSHOT_INSPECTION_TIMEOUT_MS=10000
#NERVE_SNAPSHOT_INSPECTION_HEAP_MB=512
