# 测试环境的变量（deploy/test/compose.yaml）。复制为同目录的 .env（不入库）后修改。
# 密码只用字母与数字：它们要拼进数据库的连接串。pnpm test:e2e:container 每次运行时自己生成随机密码，不读这个文件。

# 用 deploy/Dockerfile 构建的镜像
NERVE_IMAGE=nerve-office:test

# 数据库管理员、所有者角色（执行迁移）、应用角色（应用运行时）的密码。只在第一次初始化数据卷时生效
NERVE_DB_ADMIN_PASSWORD=replaceWithRandomAdminPassword
NERVE_DB_OWNER_PASSWORD=replaceWithRandomOwnerPassword
NERVE_DB_APP_PASSWORD=replaceWithRandomAppPassword

# 发布到本机回环的端口：HTTPS（公开地址是 https://localhost:<端口>）与数据库
NERVE_TEST_HTTPS_PORT=8443
NERVE_TEST_DB_PORT=54319

NERVE_LOG_LEVEL=info
# 按客户端地址的登录失败上限（窗口 15 分钟）：E2E 运行时调高
NERVE_LOGIN_IP_MAX_FAILURES=50
# 登录失败的另外两个上限（窗口 15 分钟，M2-P6）。不设时就是这些默认值：按"用户名 + 客户端地址"5 次锁定这个组合；
# 只按用户名 50 次锁定这个账户（系统管理员可以在账户页解除），必须大于上一项
#NERVE_LOGIN_MAX_FAILURES=5
#NERVE_LOGIN_ACCOUNT_MAX_FAILURES=50
# 同一条一次性链接"找到了但不能用"（过期、已用、已作废）的次数上限：到了之后这条链接暂时一律拒绝，不再写审计
#NERVE_LINK_RECORD_MAX_FAILURES=10

# 回收站里到期（30 天）的东西由应用自己清理（M2-P4）。下面三项不设时就是这些默认值；
# 排查数据时可以把 NERVE_TRASH_PURGE_ENABLED 设成 false 暂时关掉（关掉之后到期的东西要人工永久删除）
#NERVE_TRASH_PURGE_ENABLED=true
#NERVE_TRASH_PURGE_INTERVAL_MS=3600000
#NERVE_TRASH_PURGE_BATCH=50
