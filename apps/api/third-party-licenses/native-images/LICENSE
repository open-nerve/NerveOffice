Rust winapi-x86_64-pc-windows-gnu-0.4.0 源码开头声明（前 25 行）
来源：crates/winapi-x86_64-pc-windows-gnu-0.4.0.crate
归档成员：winapi-x86_64-pc-windows-gnu-0.4.0/build.rs
原始 SHA-256：b4ab421e1dc98159dd4440813cdaf7d9ea98278324bc6118d0f7cf378933f371
说明：原文件其余内容随完整源码归档提供；这里只保留开头声明，不更改声明文本。

// Copyright © 2016-2018 winapi-rs developers
// Licensed under the Apache License, Version 2.0
// <LICENSE-APACHE or http://www.apache.org/licenses/LICENSE-2.0> or the MIT license
// <LICENSE-MIT or http://opensource.org/licenses/MIT>, at your option.
// All files in the project carrying such notice may not be copied, modified, or distributed
// except according to those terms.
fn main() {
    use std::env::var;
    use std::path::Path;
    println!("cargo:rerun-if-env-changed=WINAPI_NO_BUNDLED_LIBRARIES");
    if var("WINAPI_NO_BUNDLED_LIBRARIES").is_ok() {
        return;
    }
    if var("TARGET").map(|target| target == "x86_64-pc-windows-gnu").unwrap_or(false) {
        let dir = var("CARGO_MANIFEST_DIR").unwrap();
        println!("cargo:rustc-link-search=native={}", Path::new(&dir).join("lib").display());
    }
}


