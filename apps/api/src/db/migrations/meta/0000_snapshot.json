        "audit_events_action_check": {
          "name": "audit_events_action_check",
          "value": "\"audit_events\".\"action\" IN ('auth.login_succeeded', 'auth.login_failed', 'auth.logout', 'users.admin_initialized', 'documents.created')"
        },
        "audit_events_actor_type_check": {
